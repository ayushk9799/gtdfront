{
  "name": "Diagnose It",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "watchman:repair": "watchman watch-del . || true && watchman watch-project . || true",
    "pods": "cd ios && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 LC_CTYPE=en_US.UTF-8 bundle exec pod install",
    "run:all": "npm start & npm run android & npm run ios",
    "build:android:apk": "cd android && ./gradlew assembleRelease",
    "build:android:aab": "cd android && ./gradlew bundleRelease",
    "build:ios:release": "npx react-native run-ios --configuration Release",
    "update:preview": "npx eas-cli@latest update --channel preview --platform all",
    "update:production": "npx eas-cli@latest update --channel production --platform all"
  },
